# Copy this file to .env and fill in your key: cp .env.example .env
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Any OpenRouter model that supports structured outputs. Default: openai/gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini

# Where projects are stored (relative paths are resolved from the project folder)
PROJECTS_FILE=projects.json
